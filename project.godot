; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FROG_GAME"
run/main_scene="uid://bjdglxl4fb47s"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/use_filter=false
config/icon="uid://ca7pbj1jbccv5"

[autoload]

GameManager="*uid://xppkkuoxmfhb"
TransitionLayer="*uid://b2l4lrpmr5c6y"
SnapshotsClient="*uid://cwcaoife58xkq"
GodotPlayGameServices="*uid://bnj1e5ski7rlf"
SaveManager="*uid://pw7yhdisfwif"
LootLockerSDK="*uid://c5nk2ub7xngnd"
LootLockerManager="*res://SCRIPTS/LootLockerManager.gd"
LeaderboardsClient="*uid://cag33jnv6nkas"
MusicManager="*uid://n6e3iwojfdtt"
MCPRuntimeServer="*res://addons/godot_mcp_toolkit/runtime/mcp_runtime_server.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotPlayGameServices/plugin.cfg", "res://addons/LootLockerSDK/plugin.cfg", "res://addons/godot_mcp_toolkit/plugin.cfg")

[file_customization]

folder_colors={
"res://ASSETS/": "yellow",
"res://AUDIO/": "green",
"res://SCENES/": "red",
"res://SCRIPTS/": "blue"
}

[importer_defaults]

texture={
&"compress/mode": 2
}
3d_texture={
&"compress/mode": 2
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[mcp_toolkit]

server/version="latest"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
